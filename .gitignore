# ==========================================================
# 股票数据看板工具 - .gitignore
# 技术栈: Python(FastAPI) + React(Vite) / pnpm + uv
# ==========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
installs.txt
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境（隔离环境，不入库）
.venv/
venv/
env/
ENV/
.python-version

# 测试 / 类型检查 / Lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ---------- Node / 前端 ----------
node_modules/
.pnpm-store/
.pnp.*
.yarn/
.yarn-integrity
pnpm-lock.yaml.bak

# 构建产物
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Vite / 框架缓存
.vite/
.turbo/
.next/
.nuxt/
.svelte-kit/

# 本地环境文件（前端）
*.local
.env.local
.env.*.local

# 调试日志
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
npm-debug.log*
lerna-debug.log*

# ---------- 敏感配置 / 环境变量 ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.json
config.local.*
credentials.json

# ---------- 数据 / 缓存 / 日志 ----------
data/
cache/
logs/
*.log
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-shm
*.sqlite-wal

# akshare 数据缓存
akshare_cache/
*.akshare

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# ---------- 临时文件 ----------
*.tmp
*.temp
*.bak
*.orig

# ---------- 文档构建 ----------
_site/
.docusaurus/
.cache-loader/
